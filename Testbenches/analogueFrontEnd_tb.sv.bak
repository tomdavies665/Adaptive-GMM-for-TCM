`timescale 1ns / 1ns

module analogueFrontEnd_tb;

	// 1. Signals for the DUT (Device Under Test)
    logic clk50;
    logic rst_n;
    logic start_acq;
    logic [11:0] sample_out;
    logic sample_vld;

	// DUT Instantiation
	analogue_front_end #(
		 .DECIMATION_RATIO(10) // 1 MSPS / 2.5 kHz = 400
	) dut (
		.clk50 		(clk50),      // Main system clock
		.rst_n 		(rst_n),      // Global reset
		.start_acq 	(start_acq),  // Trigger to start ADC sampling
		.sample_out (sample_out), // 12-bit filtered/decimated data
		.sample_vld	(sample_vld)  // Strobe: High for 1 clock when data is ready for GMM
	);
	
	// Clock Generation
	always #10 clk50 = ~clk50;
	
	// 4. Tasks for organized testing
    task init();
        clk50 = 0;
        rst_n = 0;
        start_acq = 0;
    endtask
	 
	 task reset_release();
        repeat(5) @(posedge clk50);
        rst_n = 1;
        $display("[%0t] Reset Released", $time);
    endtask
	 
	 // This task mimics the ADC sending data back
    task drive_mock_adc(input int num_samples);
        for (int i = 0; i < num_samples; i++) begin
            // Force the internal signals of the DUT for simulation
            @(posedge clk50);
            dut.raw_adc_data  = i;       // Send incrementing data
            dut.raw_adc_valid = 1;      // Pulse valid
            @(posedge clk50);
            dut.raw_adc_valid = 0;      // Clear valid
            repeat(5) @(posedge clk50); // Gap between ADC samples
        end
    endtask
	
	// 5. Main Test Sequence
    initial begin
        init();
        reset_release();

        // Test 1: Start Acquisition
        $display("[%0t] Starting Acquisition...", $time);
        @(posedge clk50);
        start_acq = 1;
        repeat(2) @(posedge clk50);
        start_acq = 0;

        // Test 2: Drive 25 samples (should see 2 output pulses if ratio is 10)
        drive_mock_adc(25);

        #1000;
        $display("[%0t] Simulation Finished", $time);
        $stop;
    end

endmodule
